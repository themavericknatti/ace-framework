{
    "name": "acex/ace-framework",
    "description": "The official application skeleton and starter for the Ace PHP MVC Framework.",
    "keywords": [
        "framework",
        "mvc",
        "php",
        "skeleton",
        "starter",
        "app",
        "ace"
    ],
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/themavericknatti/ace-framework",
    "support": {
        "issues": "https://github.com/themavericknatti/ace-framework/issues",
        "source": "https://github.com/themavericknatti/ace-framework"
    },
    "authors": [
        {
            "name": "Celionatti",
            "email": "celionattidev@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "acex/core": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
